# Your LG TV's LAN IP
TV_IP="192.168.0.134"

# Your TV's MAC address (for Wake-on-LAN)
TV_MAC="F4:14:BF:B7:FE:52"

# HDMI input to switch to when waking
TV_INPUT="HDMI_1"

# bscpylgtv pairing key store
KEY_FILE="$HOME/.aiopylgtv.sqlite"

# Expected HDMI display name (as shown by system_profiler SPDisplaysDataType).
# Only act when this display is connected. Use a substring — e.g. "LG TV" matches "LG TV SSCR2".
# Leave empty to match any HDMI display.
TV_DISPLAY_NAME="LG TV"

# Debounce window — suppresses duplicate power-off events (seconds)
DEBOUNCE_SECONDS=10
